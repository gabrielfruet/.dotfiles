<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gabrielfruet.obsidian-pr-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec &quot;$HOME/bin/obsidian-pr-watch&quot;</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>StandardOutPath</key>
  <string>/Users/gabrielfruet/Library/Logs/obsidian-pr-watch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/gabrielfruet/Library/Logs/obsidian-pr-watch.log</string>
</dict>
</plist>
