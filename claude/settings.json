{
  "env": {
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "mcp__2bd774d4-ae5c-457f-8050-8ab0fd823aac__slack_send_message",
      "mcp__2bd774d4-ae5c-457f-8050-8ab0fd823aac__slack_send_message_draft",
      "mcp__2bd774d4-ae5c-457f-8050-8ab0fd823aac__slack_schedule_message"
    ]
  },
  "model": "sonnet",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "outputStyle": "Concise",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' 'Load the i-have-adhd skill now, before the first response. It is on by default for every session.'"
          }
        ]
      }
    ]
  }
}